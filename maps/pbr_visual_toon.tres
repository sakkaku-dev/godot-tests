code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D Main_Texture;



void fragment() {
	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(Main_Texture, UV);


	vec3 n_out4p0;
// ColorFunc:4
	{
		vec3 c = vec3(n_out3p0.xyz);
		float max1 = max(c.r, c.g);
		float max2 = max(max1, c.b);
		n_out4p0 = vec3(max2, max2, max2);
	}


// SmoothStep:5
	float n_in5p0 = 0.50000;
	float n_in5p1 = 1.00000;
	float n_out5p0 = smoothstep(n_in5p0, n_in5p1, n_out4p0.x);


	float n_out6p0;
// Remap:6
	float n_in6p1 = 0.00000;
	float n_in6p2 = 1.00000;
	float n_in6p3 = 1.00000;
	float n_in6p4 = 0.00000;
	{
		float __input_range = n_in6p2 - n_in6p1;
		float __output_range = n_in6p4 - n_in6p3;
		n_out6p0 = n_in6p3 + __output_range * ((n_out5p0 - n_in6p1) / __input_range);
	}


// Output:0
	ALBEDO = vec3(n_out6p0);


}
"
